{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DukeOTR Verified Roblox Knowledge Entry",
  "description": "Source-checked fast-answer reference material. Entries are not automatic training data or model outputs.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "status",
    "category",
    "canonical_name",
    "aliases",
    "match_terms",
    "difficulty",
    "version_sensitivity",
    "fast_answer_depths",
    "explanations",
    "examples",
    "common_misconceptions",
    "api_names",
    "source_refs",
    "primary_source_ref",
    "last_verification",
    "training_policy",
    "evaluation_policy",
    "code_book_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^vk-[a-z0-9-]+$"},
    "status": {"enum": ["source_checked", "human_verified", "deprecated"]},
    "category": {"type": "string", "minLength": 3},
    "canonical_name": {"type": "string", "minLength": 3},
    "aliases": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}},
    "match_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "version_sensitivity": {"enum": ["stable", "review_before_fast_answer", "deprecated"]},
    "fast_answer_depths": {"type": "array", "minItems": 1, "items": {"enum": ["quick", "normal", "deep"]}},
    "explanations": {
      "type": "object",
      "required": ["quick", "normal", "deep"],
      "properties": {
        "quick": {"type": "string", "minLength": 25},
        "normal": {"type": "string", "minLength": 55},
        "deep": {"type": "string", "minLength": 55}
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "language", "purpose", "code", "depths", "api_names", "source_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "language": {"const": "luau"},
          "purpose": {"type": "string", "minLength": 12},
          "code": {"type": "string", "minLength": 12},
          "depths": {"type": "array", "minItems": 1, "items": {"enum": ["quick", "normal", "deep"]}},
          "api_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "common_misconceptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 12}},
    "api_names": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "primary_source_ref": {"type": "string"},
    "last_verification": {
      "type": "object",
      "required": ["verified_at", "review_by", "verifier", "verification_status"],
      "properties": {
        "verified_at": {"type": "string"},
        "review_by": {"type": "string"},
        "verifier": {"type": "string", "minLength": 3},
        "verification_status": {"enum": ["source_checked", "human_verified"]}
      }
    },
    "training_policy": {"const": "not_training_data_or_auto_promotion"},
    "evaluation_policy": {"const": "not_sourced_from_held_out_evaluation"},
    "code_book_refs": {"type": "array", "items": {"type": "string"}}
  }
}
