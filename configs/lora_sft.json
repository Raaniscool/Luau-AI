{
  "schema_version": "1.1",
  "project_name": "DukeOTR",
  "planned_dataset_version": "dukeotr_dataset_v1",
  "planned_adapter_version": "dukeotr_v1",
  "status": "planned_not_trained",
  "method": "lora_sft",
  "base_model": "Qwen/Qwen3-4B",
  "base_model_revision": "main",
  "training_file": "training_data/train.jsonl",
  "validation_file": "training_data/validation.jsonl",
  "output_dir": "models/adapters/dukeotr_v1-lora",
  "max_seq_length": 2048,
  "num_train_epochs": 2,
  "learning_rate": 0.0001,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "gradient_checkpointing": true,
  "bf16": true,
  "lora": {
    "r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "minimum_recommended_cuda_vram_gb": 24,
  "notes": [
    "Use only if the full-precision/bfloat16 base fits comfortably on the CUDA device.",
    "QLoRA is the recommended first experiment for DukeOTR.",
    "The presence of this configuration does not mean dukeotr_v1 has been trained."
  ]
}
